{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./.github/hooks/guard-main-commit.ps1",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./.github/hooks/guard-main-commit.ps1",
        "timeout": 15
      }
    ]
  }
}
